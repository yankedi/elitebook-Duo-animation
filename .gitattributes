# Normalize line endings in the repository; the working tree keeps the
# platform default (CRLF on Windows).
* text=auto

# Source and documentation are stored with LF.
*.cpp   text eol=lf
*.h     text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.txt   text eol=lf
*.ps1   text eol=crlf
*.bat   text eol=crlf

# Binary
*.png   binary
*.jpg   binary
*.ico   binary
*.exe   binary
*.lib   binary
*.obj   binary
*.pdb   binary
