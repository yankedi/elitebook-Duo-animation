src/build/
src/build-*/
build/
out/
bin/
obj/

# ---------------------------------------------------------------------------
#  Runtime output (CSV logs, startup reports)
# ---------------------------------------------------------------------------
**/logs/
startup-report.txt
*.csv

# --dump-frames writes these; they are for looking at, not for keeping.
fold-dump-*.bmp

# ---------------------------------------------------------------------------
#  Third-party reference projects
#
#  These directories are independent git clones.  They carry their own
#  history and their own licenses (see src/ATTRIBUTION.md), they are used as
#  read-only reference material, and they are deliberately NOT tracked here --
#  an outer repository would otherwise treat them as embedded repositories.
#
#  lid-plane (GPL-3.0) is strategy-only: its gate and activation-angle model
#  are reimplemented from its documented behaviour, no code or shader text is
#  copied, and nothing here links against it.
# ---------------------------------------------------------------------------
/Duo-animation/
/duo-open/
/iphone-duo/
/iphone-duo-animation/
/lid-plane/

